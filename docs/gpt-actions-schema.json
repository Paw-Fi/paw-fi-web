    "/set-budget": {
      "post": {
        "x-openai-defaults": {
          "headers": {
            "apikey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFidXlueXh5ZW1pZ3RudmR1anRzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc0NzkxNzI4MiwiZXhwIjoyMDYzNDkzMjgyfQ.IlupdrXONYkkV2_75q5V8M7-MY_b5MU_-3fiMtR5XAM"
          }
        },
        "operationId": "setBudget",
        "summary": "Set the user's daily budget",
        "description": "Creates or updates the caller's daily budget for a specific date. GPT callers must include a date so the backend can align with the user's timezone without relying on server time.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetBudgetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Budget stored. GPT callers receive a plain-text confirmation message.",
