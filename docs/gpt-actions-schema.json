  "components": {
    "schemas": {
      "SaveExpenseRequest": {
        "type": "object",
        "required": [
          "amount",
          "category",
          "currency",
          "date"
        ],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Expense amount in major currency units (e.g., 5.25). Must be greater than 0."
          },
          "category": {
            "type": "string",
            "description": "Expense category label."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g., USD, EUR)."
          },
          "date": {
            "type": "string",
            "description": "ISO date (YYYY-MM-DD) or datetime."
          },
          "clientCreatedAt": {
            "type": "string",
            "description": "Optional client-side timestamp with timezone (ISO)."
          },
          "description": {
            "type": "string",
            "description": "Optional note or raw text."
          },
          "receiptImageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Optional receipt image URL."
          },
          "householdId": {
            "type": "string",
            "format": "uuid",
            "description": "Household UUID to share the expense with."
          }
        },
        "additionalProperties": false
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "contact_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_cents": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "raw_text": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "receipt_image_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "household_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "split_group_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
        },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "SaveExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/Expense"
          },
          "shared": {
            "type": "boolean",
            "description": "True when a household split was created."
          },
          "warning": {
            "type": "string",
            "description": "Optional warning if the household split or notifications could not be completed."
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend ultimately used (helpful when GPT created a guest user)."
          },
          "meta": {
            "type": "object",
            "description": "Additional metadata about identity resolution, including guest creation flags."
          }
        },
        "required": [
          "success",
          "data",
          "shared"
        ]
      },
      "AnalyzeExpenseRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Free-form description that may contain expense details."
          },
          "image": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "description": "Base64-encoded image payload."
              },
              "contentType": {
                "type": "string",
                "description": "Image MIME type such as image/jpeg."
              }
            },
            "required": [
              "data",
              "contentType"
            ],
            "additionalProperties": false
          },
          "date": {
            "type": "string",
            "description": "Optional ISO date (defaults to today)."
          },
          "currency": {
            "type": "string",
            "description": "Caller preferred currency code for fallback."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ]
          },
          {
            "required": [
              "image"
            ]
          }
        ]
      },
      "AnalyzeExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExpenseAnalysisItem"
                }
              },
              "isAnalyzed": {
                "type": "boolean",
                "description": "Flag indicating the expense was parsed but not persisted."
              }
            }
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend used for analysis (guest or authenticated)."
          },
          "meta": {
            "type": "object",
            "description": "Identity metadata including conversationId and guest creation flags."
          }
        }
      },
      "SetBudgetRequest": {
        "type": "object",
        "required": [
          "amount"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 formatted phone number. Required for non-GPT callers when userId is absent."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User UUID. Optional for GPT callers because identity is derived from headers."
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Daily budget amount in major currency units (e.g., 25.50). Must be positive."
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD date to apply the budget. Required for GPT callers; non-GPT requests default to today's date when omitted."
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code. Defaults to the contact's preferred currency or USD."
          }
        },
        "additionalProperties": false
      },
      "SetBudgetSuccessResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "Date the budget applies to (YYYY-MM-DD)."
              },
              "currency": {
                "type": "string"
              },
              "budget_set": {
                "type": "object",
                "properties": {
                  "amount_cents": {
                    "type": "integer"
                  },
                  "date": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              },
              "totals": {
                "type": "object",
                "properties": {
                  "budget_cents": {
                    "type": "integer"
                  },
                  "spent_cents": {
                    "type": "integer"
                  },
                  "remaining_cents": {
                    "type": "integer"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reply": {
            "type": "string",
            "description": "Human-readable summary returned to non-GPT callers."
          },
          "meta": {
            "type": "object",
            "description": "Identity metadata (conversationId, guest flags, etc.)."
          }
        }
      },
      "GetBudgetRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 formatted phone number. Required for non-GPT callers when userId is absent."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User UUID. Optional for GPT callers because identity is derived from headers."
          },
          "date": {
            "type": "string",
            "description": "ISO date (YYYY-MM-DD) to report totals through. Required for GPT callers; non-GPT requests default to today's date when omitted."
          },
          "currency": {
            "type": "string",
            "description": "ISO currency filter. Defaults to the contact's preferred currency or USD."
          },
          "day": {
            "type": "integer",
            "description": "Optional explicit day-of-month for the projection window."
          }
        },
        "additionalProperties": false
      },
      "GetBudgetSuccessResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "currency": {
                "type": "string"
              },
              "dayRequested": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "dayApplied": {
                "type": "integer"
              },
              "daysInMonth": {
                "type": "integer"
              },
              "dailyBudgetCents": {
                "type": "integer"
              },
              "totals": {
                "type": "object",
                "properties": {
                  "monthBudgetCents": {
                    "type": "integer"
                  },
                  "toDateBudgetCents": {
                    "type": "integer"
                  },
                  "spentToDateCents": {
                    "type": "integer"
                  },
                  "remainingToDateCents": {
                    "type": "integer"
                  },
                  "projectedMonthRemainingCents": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "meta": {
            "type": "object",
            "description": "Identity metadata (conversationId, guest flags, etc.)."
          }
        }
      },
      "ExpenseAnalysisItem": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "currencySymbol": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ListExpensesRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Supabase UUID for an authenticated user. GPT callers typically omit this and rely on header-based resolution."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "startDate": {
            "type": "string",
            "description": "Lower bound in ISO date format."
          },
          "endDate": {
            "type": "string",
            "description": "Upper bound in ISO date format."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code to filter expenses (e.g., USD, EUR, GBP)."
          }
