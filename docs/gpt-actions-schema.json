          }
        },
        "operationId": "getBudget",
        "summary": "Retrieve the user's daily budget and projections",
        "description": "Fetches the most recent daily budget in a currency and reports spend-to-date against the requested day. GPT callers must send the date they want totals for so calculations match the user's timezone.",
        "requestBody": {
          "required": true,
