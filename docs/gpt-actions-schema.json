            "type": "string",
            "format": "uuid",
            "description": "User ID used when the error occurred (if resolved)."
          },
          "meta": {
            "type": "object",
            "description": "Additional diagnostic data."
          }
        }
      },
      "DeleteExpenseRequest": {
        "type": "object",
        "properties": {
          "expenseIds": {
            "type": "string",
            "description": "Comma-separated list of expense UUIDs to delete."
          },
          "expenseId": {
            "type": "string",
            "format": "uuid",
            "description": "Expense UUID to delete (legacy; prefer expenseIds)."
          }
        },
        "additionalProperties": false
      },
      "DeleteExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend ultimately used (helpful when GPT created a guest user)."
          },
          "meta": {
            "type": "object",
            "description": "Additional metadata about identity resolution, including guest creation flags."
          }
        },
        "required": ["success"]
      },
      "UpdateExpenseRequest": {
        "type": "object",
        "required": ["expenseId", "updates"],
        "properties": {
          "expenseId": {
            "type": "string",
            "format": "uuid",
            "description": "Expense UUID to update."
          },
          "updates": {
            "type": "object",
            "description": "Fields to update in the expense.",
            "properties": {
              "amount_cents": {
                "type": "integer",
                "description": "Amount in cents (e.g., 500 for $5.00)."
              },
              "category": {
                "type": "string",
                "description": "Expense category."
              },
              "raw_text": {
                "type": "string",
                "description": "Description or note about the expense."
              },
              "date": {
                "type": "string",
                "format": "date",
                "description": "Expense date in YYYY-MM-DD format."
              },
              "currency": {
                "type": "string",
                "description": "ISO currency code (e.g., USD, EUR)."
              }
            },
            "minProperties": 1
          }
        },
        "additionalProperties": false
      },
      "UpdateExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "type": "object",
            "description": "The updated expense record."
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend ultimately used (helpful when GPT created a guest user)."
          },
          "meta": {
            "type": "object",
            "description": "Additional metadata about identity resolution, including guest creation flags."
          }
        },
        "required": ["success", "data"]
      }
    }
  }
}
