  "components": {
    "schemas": {
      "SaveExpenseRequest": {
        "type": "object",
        "required": ["amount", "category", "currency", "date"],
        "properties": {
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Expense amount in major currency units (e.g., 5.25). Must be greater than 0."
          },
          "category": {
            "type": "string",
            "description": "Expense category label."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code (e.g., USD, EUR)."
          },
          "date": {
            "type": "string",
            "description": "ISO date (YYYY-MM-DD) or datetime."
          },
          "clientCreatedAt": {
            "type": "string",
            "description": "Optional client-side timestamp with timezone (ISO)."
          },
          "description": {
            "type": "string",
            "description": "Optional note or raw text."
          },
          "receiptImageUrl": {
            "type": "string",
            "format": "uri",
            "description": "Optional receipt image URL."
          }
        },
        "additionalProperties": false
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "contact_id": {
            "type": "string",
            "format": "uuid"
          },
          "amount_cents": {
            "type": "integer"
          },
          "category": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "raw_text": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "receipt_image_url": {
            "type": ["string", "null"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "SaveExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "$ref": "#/components/schemas/Expense"
          },
          "shared": {
            "type": "boolean",
            "enum": [false],
            "description": "Always false for personal budgeting."
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend ultimately used (helpful when GPT created a guest user)."
          },
          "meta": {
            "type": "object",
            "description": "Additional metadata about identity resolution, including guest creation flags."
          }
        },
        "required": ["success", "data", "shared"]
      },
      "AnalyzeExpenseRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Free-form description that may contain expense details."
          },
          "image": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string",
                "description": "Base64-encoded image payload."
              },
              "contentType": {
                "type": "string",
                "description": "Image MIME type such as image/jpeg."
              }
            },
            "required": ["data", "contentType"],
            "additionalProperties": false
          },
          "date": {
            "type": "string",
            "description": "Optional ISO date (defaults to today)."
          },
          "currency": {
            "type": "string",
            "description": "Caller preferred currency code for fallback."
          },
          "currencySymbol": {
            "type": "string",
            "description": "Optional currency symbol based on user location (e.g., '$', '€', 'RM'). If not provided, will be inferred from currency."
          }
        },
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["text"]
          },
          {
            "required": ["image"]
          }
        ]
      },
      "AnalyzeExpenseSuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ExpenseAnalysisItem"
                }
              },
              "isAnalyzed": {
                "type": "boolean",
                "description": "Flag indicating the expense was parsed but not persisted."
              }
            }
          },
          "resolvedUserId": {
            "type": "string",
            "format": "uuid",
            "description": "User ID the backend used for analysis (guest or authenticated)."
          },
          "meta": {
            "type": "object",
            "description": "Identity metadata including conversationId and guest creation flags."
          }
        }
      },
      "SetBudgetRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 formatted phone number. Required for non-GPT callers when userId is absent."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User UUID. Optional for GPT callers because identity is derived from headers."
          },
          "amount": {
            "type": "number",
            "format": "double",
            "description": "Daily budget amount in major currency units (e.g., 25.50). Must be positive."
          },
          "date": {
            "type": "string",
            "description": "YYYY-MM-DD date to apply the budget. Required for GPT callers; non-GPT requests default to today's date when omitted."
          },
          "currency": {
            "type": "string",
            "description": "ISO currency code. Defaults to the contact's preferred currency or USD."
          }
        },
        "additionalProperties": false
      },
      "SetBudgetSuccessResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "description": "Date the budget applies to (YYYY-MM-DD)."
              },
              "currency": {
                "type": "string"
              },
              "budget_set": {
                "type": "object",
                "properties": {
                  "amount_cents": {
                    "type": "integer"
                  },
                  "date": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              },
              "totals": {
                "type": "object",
                "properties": {
                  "budget_cents": {
                    "type": "integer"
                  },
                  "spent_cents": {
                    "type": "integer"
                  },
                  "remaining_cents": {
                    "type": "integer"
                  },
                  "currency": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reply": {
            "type": "string",
            "description": "Human-readable summary returned to non-GPT callers."
          },
          "meta": {
            "type": "object",
            "description": "Identity metadata (conversationId, guest flags, etc.)."
          }
        }
      },
      "GetBudgetRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "E.164 formatted phone number. Required for non-GPT callers when userId is absent."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "User UUID. Optional for GPT callers because identity is derived from headers."
          },
          "date": {
            "type": "string",
            "description": "ISO date (YYYY-MM-DD) to report totals through. Required for GPT callers; non-GPT requests default to today's date when omitted."
          },
          "currency": {
            "type": "string",
            "description": "ISO currency filter. Defaults to the contact's preferred currency or USD."
          },
          "day": {
            "type": "integer",
            "description": "Optional explicit day-of-month for the projection window."
          }
        },
        "additionalProperties": false
      },
      "GetBudgetSuccessResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "results": {
